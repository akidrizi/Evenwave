{
  "manifest_version": 3,
  "name": "Evenwave",
  "version": "1.0.0",
  "description": "Detects one-sided audio on YouTube, Twitch, Vimeo and more, and fixes it live — with a heads-up the moment it kicks in.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://*.twitch.tv/*",
    "https://*.kick.com/*",
    "https://*.vimeo.com/*",
    "https://*.dailymotion.com/*",
    "https://*.soundcloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*",
        "https://*.twitch.tv/*",
        "https://*.kick.com/*",
        "https://*.vimeo.com/*",
        "https://*.dailymotion.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Evenwave",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
